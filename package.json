{
  "name": "hi-tech.ck.ua",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome ci",
    "ts-check": "tsc --project tsconfig.json --pretty --noEmit && echo ",
    "dev:status-proxy": "wrangler dev --config workers/status-proxy/wrangler.jsonc --port 8787",
    "dev:legacy-redirects": "wrangler dev --config workers/legacy-redirects/wrangler.jsonc --port 8788",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy && bun run deploy:status-proxy && bun run deploy:legacy-redirects",
    "deploy:status-proxy": "wrangler deploy --config workers/status-proxy/wrangler.jsonc",
    "deploy:legacy-redirects": "wrangler deploy --config workers/legacy-redirects/wrangler.jsonc",
    "deploy:static-redirects": "bun scripts/deploy-static-redirects.ts",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@vis.gl/react-google-maps": "1.9.0",
    "clsx": "2.1.1",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@tailwindcss/postcss": "4.3.3",
    "@types/google.maps": "3.65.4",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/supercluster": "7.1.3",
    "code-inspector-plugin": "2.0.7",
    "postcss": "8.5.25",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "wrangler": "4.118.0"
  },
  "packageManager": "bun@1.3.14"
}
