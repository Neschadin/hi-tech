NEXTJS_ENV=development
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=c0788552a798ed0d535ca967
# Optional: for workers.dev without custom domain route
# NEXT_PUBLIC_REPAIR_STATUS_API=https://hi-tech-status-proxy.<account>.workers.dev
# GitHub Actions secrets (repo settings):
# CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID, NEXT_PUBLIC_GOOGLE_MAPS_API_KEY
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID is public; set in workflow env or .env.local
# Worker runtime secrets (wrangler secret put on hi-tech-status-proxy):
# Workers cannot fetch() raw IPs — use hostname (A record, DNS only)
ONEC_URL=http://onec.hi-tech.ck.ua:38380/mb/hs/exchange_hi_tech/data_service
ONEC_USER=
ONEC_PASS=
# Worker-side secret for the existing Turnstile widget (siteverify),
# set via: wrangler secret put TURNSTILE_SECRET
TURNSTILE_SECRET=
