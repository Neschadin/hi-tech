{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hi-tech-status-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-29",
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "routes": [
    {
      "pattern": "hi-tech.ck.ua/api/repair-status",
      "zone_name": "hi-tech.ck.ua"
    }
  ]
}
